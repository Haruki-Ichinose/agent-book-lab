# -----------------------------------------------------------------------------
# Cloud APIs (primary)
# -----------------------------------------------------------------------------
# Create keys in the OpenAI and Tavily dashboards, then paste them into .env.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Cloud model selection
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# Keep tracing off until a LangSmith account is intentionally connected.
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agent-book-lab
