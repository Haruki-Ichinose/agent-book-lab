# LM Studio's OpenAI-compatible endpoint. LM Link also resolves through localhost.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Copy the exact IDs returned by: uv run python scripts/check_lmstudio.py
LM_STUDIO_FAST_MODEL=
LM_STUDIO_STRONG_MODEL=
LM_STUDIO_EMBEDDING_MODEL=
MODEL_PROFILE=fast

# Keep tracing off until a LangSmith account is intentionally connected.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=agent-book-lab
